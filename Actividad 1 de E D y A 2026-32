#include <iostream>
#include <string>
using namespace std;

struct Estudiante {
    string nombre;
    string matricula;
    float calificaciones[5];
    float promedio;
    string estado;
};

int main() {

    const int MAX = 100;

    Estudiante estudiantes[MAX];

    int totalEstudiantes = 0;
    int opcion;

    do {

        cout << "\n===== REGISTRO DE CALIFICACIONES EN BOOTCAMP =====\n";
        cout << "1. Registrar estudiante\n";
        cout << "2. Mostrar todos los estudiantes\n";
        cout << "3. Mostrar estudiantes aprobados\n";
        cout << "4. Ordenar estudiantes por promedio\n";
        cout << "5. Salir\n";
        cout << "Seleccione una opcion: ";
        cin >> opcion;

        switch(opcion) {

            case 1: {

                if (totalEstudiantes >= MAX) {
                    cout << "\nNo se pueden registrar mas estudiantes.\n";
                    break;
                }

                cout << "\n===== REGISTRAR ESTUDIANTE =====\n";

                cin.ignore();

                cout << "Nombre: ";
                getline(cin, estudiantes[totalEstudiantes].nombre);

                cout << "Matricula: ";
                getline(cin, estudiantes[totalEstudiantes].matricula);

                float suma = 0;

                for (int i = 0; i < 5; i++) {

                    cout << "Calificacion " << i + 1 << ": ";
                    cin >> estudiantes[totalEstudiantes].calificaciones[i];

                    suma += estudiantes[totalEstudiantes].calificaciones[i];
                }

                estudiantes[totalEstudiantes].promedio = suma / 5;

                if (estudiantes[totalEstudiantes].promedio >= 70) {
                    estudiantes[totalEstudiantes].estado = "APROBADO";
                }
                else {
                    estudiantes[totalEstudiantes].estado = "REPROBADO";
                }

                cout << "\nPromedio calculado: "
                     << estudiantes[totalEstudiantes].promedio << endl;

                cout << "Estado: "
                     << estudiantes[totalEstudiantes].estado << endl;

                totalEstudiantes++;

                cout << "\nEstudiante registrado correctamente.\n";

                break;
            }

            case 2: {

                cout << "\n===== LISTADO DE ESTUDIANTES =====\n";

                if (totalEstudiantes == 0) {
                    cout << "No hay estudiantes registrados.\n";
                }
                else {

                    for (int i = 0; i < totalEstudiantes; i++) {

                        cout << "\nEstudiante #" << i + 1 << endl;

                        cout << "Nombre: "
                             << estudiantes[i].nombre << endl;

                        cout << "Matricula: "
                             << estudiantes[i].matricula << endl;

                        cout << "Calificaciones: ";

                        for (int j = 0; j < 5; j++) {
                            cout << estudiantes[i].calificaciones[j] << " ";
                        }

                        cout << endl;

                        cout << "Promedio: "
                             << estudiantes[i].promedio << endl;

                        cout << "Estado: "
                             << estudiantes[i].estado << endl;
                    }
                }

                break;
            }

            case 3: {

                bool encontrado = false;

                cout << "\n===== ESTUDIANTES APROBADOS =====\n";

                for (int i = 0; i < totalEstudiantes; i++) {

                    if (estudiantes[i].promedio >= 70) {

                        cout << "\nNombre: "
                             << estudiantes[i].nombre << endl;

                        cout << "Matricula: "
                             << estudiantes[i].matricula << endl;

                        cout << "Promedio: "
                             << estudiantes[i].promedio << endl;

                        cout << "Estado: "
                             << estudiantes[i].estado << endl;

                        encontrado = true;
                    }
                }

                if (!encontrado) {
                    cout << "\nNo hay estudiantes aprobados.\n";
                }

                break;
            }

            case 4: {

                Estudiante temp;

                for (int i = 0; i < totalEstudiantes - 1; i++) {

                    for (int j = i + 1; j < totalEstudiantes; j++) {

                        if (estudiantes[i].promedio < estudiantes[j].promedio) {

                            temp = estudiantes[i];
                            estudiantes[i] = estudiantes[j];
                            estudiantes[j] = temp;
                        }
                    }
                }

                cout << "\n===== ESTUDIANTES ORDENADOS POR PROMEDIO =====\n";

                for (int i = 0; i < totalEstudiantes; i++) {

                    cout << "\nPosicion #" << i + 1 << endl;

                    cout << "Nombre: "
                         << estudiantes[i].nombre << endl;

                    cout << "Matricula: "
                         << estudiantes[i].matricula << endl;

                    cout << "Promedio: "
                         << estudiantes[i].promedio << endl;

                    cout << "Estado: "
                         << estudiantes[i].estado << endl;
                }

                break;
            }

            case 5:
                cout << "\nSaliendo del sistema...\n";
                break;

            default:
                cout << "\nOpcion no valida.\n";
        }

    } while(opcion != 5);

    return 0;
}
